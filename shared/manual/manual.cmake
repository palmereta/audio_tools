# dh_add_manual(<target> <carpeta del manual>): embebe en.md, es.md y las capturas de img/ en el plugin para
# el visor (shared/manual/ManualView.h). Si todavía no hay manual, el plugin compila igual sin el botón.
function(dh_add_manual target dir)
    set(files)
    foreach(f en.md es.md)
        if(EXISTS ${dir}/${f})
            list(APPEND files ${dir}/${f})
        endif()
    endforeach()
    file(GLOB imgs CONFIGURE_DEPENDS ${dir}/img/*.jpg)
    list(APPEND files ${imgs})
    target_include_directories(${target} PRIVATE ${CMAKE_SOURCE_DIR}/shared/manual)
    if(files)
        juce_add_binary_data(${target}Manual HEADER_NAME ManualData.h NAMESPACE ManualData SOURCES ${files})
        target_link_libraries(${target} PRIVATE ${target}Manual)
        target_compile_definitions(${target} PRIVATE DH_HAS_MANUAL=1)
    else()
        target_compile_definitions(${target} PRIVATE DH_HAS_MANUAL=0)
    endif()
endfunction()
